---
const { id, class: className, contain = true, hero = false, pageHero = false } = Astro.props;
---

<section id={id} class={className}>
    <div class:list={[
        contain && "container", 
        pageHero == false && hero == false && "py-16 lg:py-32",
        hero && "py-16 lg:pb-32 lg:pt-28",
		pageHero && "py-16 lg:pb-32 lg:pt-28"
    ]}>
        <slot />
    </div>
</section>