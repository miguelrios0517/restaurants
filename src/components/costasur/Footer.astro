---
import { menuMain } from "~/data/costasur/menus";
const currentYear = new Date().getFullYear();
import { siteName } from "~/data/gingerteriyaki/config";
import { Picture, Image } from "astro:assets";
import Logo from "~/assets/images/costasur/costasur_logo.png";

---

<footer class="bg-brand-black text-white">
	<div class="container pt-16 pb-8">
		<Picture
				class="mx-auto h-[100px] w-[147px] object-contain" 
				src={Logo}
				width={147}
				height={100}
				widths={[147, 294]} 
				sizes="147px" 
				formats={["avif", "webp"]}
				alt="Costa Sur Taqueria Logo"
				loading="eager"
				fetchpriority="high"
		/>
		<nav class="flex flex-col sm:flex-row items-center justify-center gap-x-12 gap-y-3 font-medium mt-6" aria-label="Footer">
			{
				menuMain.map((item) => (
					<a href={item.url} class="hover:underline">
						{item.name}
					</a>
				))
			}
		</nav>
		<p class="mt-10 text-center text-sm">&copy; {currentYear} {siteName}. All rights reserved. <a class="underline" href="/privacy-policy">Privacy policy</a></p>
	</div>
</footer>
