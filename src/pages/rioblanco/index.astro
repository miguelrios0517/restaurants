---
import Layout from "~/layouts/rioblanco/Layout.astro";
import Section from "~/components/Section.astro";
import Hero from "~/components/Hero.astro";
import { Picture, Image } from "astro:assets";
import Badge from "~/components/Badge.astro";
import Button from "~/components/Button.astro";

import ButtonCallUs from "~/components/mercadolatino/ButtonCallUs.astro";
import Grid from "~/components/Grid.astro";
import Heading from "~/components/Heading.astro";
import WideImage from "~/components/WideImage.astro";
import ReviewSlider from "~/components/mercadolatino/ReviewSlider.astro";

// Images
import HeroImage from "~/assets/images/rioblanco/restaurantinside_cropped.jpg"
import FrontStore from "~/assets/images/rioblanco/fajitas_cropped.jpg"
import Service1 from "~/assets/images/rioblanco/carneasada_cropped.jpg";
import Service2 from "~/assets/images/costasur/tacos.jpg";
import Service3 from "~/assets/images/rioblanco/table1_cropped.jpg";
import About from "~/assets/images/rioblanco/restaurant2_cropped.jpg"
import Promotion from "~/assets/images/costasur/tacos3.jpg";
import reviewAuthors from "~/assets/images/template/review-authors.png";

---

<Layout title="Home" pageTitle="Home" description="Welcome to our restaurant!">
	<Section hero=true class:list={"brand-bg"}>
		<Hero>
			<div slot="hero-content-left" class="prose max-w-none max-lg:order-1">
				<Badge color="secondary" title="Fresh Mexican Food in Auburn" />
				<h1 class="text-brand-black">Welcome to <span class="text-brand-primary">Rio Blanco Mexican</span> Restaurant</h1>

				<p>
					Bring your appetite to Auburn’s favorite family-owned taco spot. We serve up hand-pressed tortillas, slow-simmered birria, and vibrant salsas made fresh daily. Taste the tradition of authentic Mexican street food right here in Washington.
				</p>

				<span class="text-brand-black font-medium">✔ Call Ahead for Takeout</span>

				<div class="mt-8 flex items-center gap-x-8">
					<Button color="secondary" url="/book">Get Directions</Button>
					<ButtonCallUs />
				</div>
			</div>
			<div slot="hero-content-right">
				<Picture
					class:list={"mx-auto mercado-image-blob"}
					src={HeroImage}
					height={600}
					formats={["avif", "webp"]}
					alt="A description of my image."
					loading={"eager"}
					fetchpriority={"high"}
				/>
			</div>
		</Hero>
	</Section>

	<WideImage image={FrontStore} alt="Just an image" class:list={"aspect-video lg:aspect-[16/6]"} />

	<!-- Dishes -->
	<Section class:list={"brand-bg"}>
		<Heading>
			<h2 slot="heading-title" class="font-black h2">Our Menu</h2>
			<p slot="heading-content">
Explore our family recipes, crafted with fresh, local ingredients.
			</p>
		</Heading>

		<Grid>
			<div slot="grid-content-1">
				<div class="flex flex-col items-center prose text-center">
					<Picture
						class:list={"not-prose w-full h-auto mercado-image-blob"}
						src={Service1}
						formats={["avif", "webp"]}
						alt="A description of my image."
					/>
					<h3 class="h4 mt-0 font-black">House Platters</h3>
					<p>
						Full-sized authentic Mexican entrees served with savory red rice and your choice of refried or black beans.
					</p>
				</div>
			</div>

			<div slot="grid-content-2">
				<div class="flex flex-col items-center prose text-center">
					<Picture
						class:list={"not-prose w-full h-auto mercado-image-blob"}
						src={Service2}
						formats={["avif", "webp"]}
						alt="A description of my image."
					/>
					<h3 class="h4 mt-0 font-black">Tacos & Wraps</h3>
					<p>
						Handcrafted classics featuring fresh street tacos, loaded burritos, toasted tortas, and crispy quesadillas.
					</p>
				</div>
			</div>

			<div slot="grid-content-3">
				<div class="flex flex-col items-center prose text-center">
					<Picture
						class:list={"not-prose w-full h-auto mercado-image-blob"}
						src={Service3}
						formats={["avif", "webp"]}
						alt="A description of my image."
					/>
					<h3 class="h4 mt-0 font-black">Sizzling Grills</h3>
					<p>
						Flame-broiled skirt steak, juicy chicken, and tiger shrimp served snapping hot over sweet peppers and onions
					</p>
				</div>
			</div>
		</Grid>
	</Section>

	<!-- Promotion -->
	<Section class:list={"brand-bg"}>
		<Hero>
			<div slot="hero-content-left" class="prose max-w-none">
				<Badge color="primary" title="Special Promotion" />
				<h2 slot="heading-title" class="font-black text-brand-secondary h2 !my-4">Lunch Special Taco Plate for Only $10</h2>
				<div slot="heading-content">
					<p>
						Satisfy your cravings with our unbeatable everyday deal. Mix and match four of your favorite street tacos for just $10. Valid for dine-in or to go!
					</p>

					<span class="text-brand-secondary font-medium">
						✔ We also do take-away, so you can enjoy your food at home
					</span>

					<div class="mt-8">
						<Button color="primary" url="/book">Call For Takeout</Button>
					</div>
				</div>
			</div>

			<div slot="hero-content-right">
				<Picture
					class:list={"mx-auto mercado-image-blob"}
					src={Promotion}
					height={600}
					formats={["avif", "webp"]}
					alt="A description of my image."
				/>
			</div>
		</Hero>
	</Section>

	<!-- Reviews -->
	<Section class:list={"bg-brand-secondary/30 relative"}>
		<div class="py-16">
			<Hero>
				<div slot="hero-content-left" class="prose max-w-none order-2">
					<div class="text-center not-prose">
						<Badge color="white" title="Customer Reviews" />
					</div>
					<h2 slot="heading-title" class="font-black h4 text-center mt-0 mb-4">What Our Locals Are Saying</h2>
					<div slot="heading-content">
						<p class="text-center">
							See what our Auburn neighbors love about us. Real, live guest experiences featured below!
						</p>

						<ReviewSlider />
					</div>
				</div>

				<div slot="hero-content-right">
					<Picture height={400} src={reviewAuthors} alt="Review authors">
				</div>
			</Hero>
		</div>

		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 1440 320"
			class="absolute h-40 w-full top-0 inset-x-0 rotate-180 fill-brand-bg"
			preserveAspectRatio="none"
			><path
				fill-opacity="1"
				d="M0,288L48,272C96,256,192,224,288,197.3C384,171,480,149,576,165.3C672,181,768,235,864,250.7C960,267,1056,245,1152,250.7C1248,256,1344,288,1392,304L1440,320L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
			></path>
		</svg>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 1440 320"
			class="absolute h-40 w-full bottom-0 inset-x-0 fill-brand-bg"
			preserveAspectRatio="none"
			><path
				fill-opacity="1"
				d="M0,288L48,272C96,256,192,224,288,197.3C384,171,480,149,576,165.3C672,181,768,235,864,250.7C960,267,1056,245,1152,250.7C1248,256,1344,288,1392,304L1440,320L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
			></path>
		</svg>
	</Section>

	<!-- About -->
	<Section class:list={"brand-bg"}>
		<Hero>
			<div slot="hero-content-left" class="prose lg:order-2">
				<h2 class="font-black">The Story of Rio Blanco Restaurant</h2>

				<p>
					Founded by our family, Rio Blanco Restaurant started with a simple mission: to bring the rich, bold flavors of our childhood home in Michoacán straight to the Pacific Northwest. We believe that great food starts with time-honored traditions, which is why our meats are marinated for 24 hours, our salsas are chopped every morning, and our corn tortillas are pressed by hand to order.
				</p>

				<p>
				Whether you are grabbing a quick lunch break near Game Farm Park or sitting down for a weekend family feast, we welcome you into our kitchen with open arms and full plates. Come taste the passion in every single bite!
				</p>

				<div class="mt-8">
					<Button color = "primary" url="/menu">
						
						Get Directions
					</Button>
				</div>
			</div>
			<div slot="hero-content-right">
				<Picture
					class:list={"mx-auto mercado-image-blob"}
					src={About}
					height={600}
					formats={["avif", "webp"]}
					alt="A description of my image."
				/>
			</div>
		</Hero>
	</Section>

	<!-- Map -->
	<iframe width="100%" height="600px" frameborder="0" title="map" marginheight="0" marginwidth="0" scrolling="no" src="https://maps.google.com/maps?width=100%&amp;height=600&amp;hl=en&amp;q=RioBlancoMexicanRestaurantAuburn&amp;ie=UTF8&amp;t=&amp;z=14&amp;iwloc=B&amp;output=embed"></iframe>	
</Layout>
