---
import Layout from "~/layouts/rioblanco/Layout.astro";;;;
import Section from "~/components/Section.astro";
import Heading from "~/components/Heading.astro";
import FormBook from "~/components/forms/FormBook.astro";
---

<Layout>
	<Section hero=true  class:list={'brand-bg'}> 
		<Heading>
			<h2 slot="heading-title" class="font-black h2">Book A Table Rio Blanco Restaurant </h2>
			<p slot="heading-content" class="text-pretty">
				Reserve a table for your next meal. We'll get back to you to confirm your booking.
			</p>
		</Heading>

		<FormBook />
	</Section>
</Layout>
