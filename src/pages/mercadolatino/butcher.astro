---
import Layout from "~/layouts/mercadolatino/Layout.astro";
import Section from "~/components/Section.astro";
import Hero from "~/components/Hero.astro";
import { Picture } from "astro:assets";
import Badge from "~/components/Badge.astro";
import Button from "~/components/Button.astro";
import ButtonCallUs from "~/components/mercadolatino/ButtonCallUs.astro";
import Article from "~/components/Article.astro";

// Images
import PizzaHero from "~/assets/images/mercadolatino/grocery.jpg";
import AboutHero from "~/assets/images/mercadolatino/butcher_2.jpg";

---

<Layout dataTheme="mercado-latino">
	<Section hero=true class:list={"brand-bg"}>
		<Hero>
			<div slot="hero-content-left" class="prose max-w-none max-lg:order-1">
				<Badge color="primary" title="El Mercado Latino in Auburn, WA" />
				<h1 class="font-black">Premium Quality Meats in Auburn, WA</h1>

				<p>
					Welcome to the premier butcher counter at El Mercado Latino. We take absolute pride in offering our Auburn community the finest selection of hand-cut, premium meats. From everyday family dinners to weekend barbecues, find the absolute best cuts right here.
				</p>

				<span class="text-brand-primary font-medium">✔ High Quality USDA Prime Meats</span>

				<div class="mt-8 flex items-center gap-x-8">
					<Button url="/book">Get Directions</Button>
					<ButtonCallUs />
				</div>
			</div>
			<div slot="hero-content-right">
				<Picture
					class:list={"mx-auto image-blob"}
					src={AboutHero}
					height={600}
					formats={["avif", "webp"]}
					alt="A description of my image."
					loading={"eager"}
					fetchpriority={"high"}
				/>
			</div>
		</Hero>
	</Section>

	<Section class:list={'brand-bg'}>
		<Article>
			<h2>Expert In-House Cuts</h2>
			<p>
				Our skilled, traditional butchers are always on hand to custom-cut your meats exactly how you want them. Whether you need specific trims for a family recipe or advice on the perfect cut for your dinner plan, we deliver <strong>unparalleled freshness and local expertise</strong>.
			</p>

			<h3>Sustainably Sourced</h3>
			<p>
				We closely partner with trusted local farmers to provide you with sustainably raised, high-quality meats. Taste the exceptional difference that genuine freshness brings to your table.
			</p>

			<h3>Marinated Meats</h3>
			<blockquote>"Ready-to-Grill Meats for Your Next Carne Asada"</blockquote>
			<p>
				Save time without sacrificing authentic flavor! Our signature carne asada and marinated meats are expertly seasoned daily using traditional family recipes and fresh ingredients. Perfectly prepped and ready for the grill, they make serving delicious, high-quality Mexican meals at home incredibly easy.
			</p>

			<h4>What Makes Us Special?</h4>
			<ul>
				<li><strong>Authentic & Fresh:</strong> Premium meats, hot meals, and fresh bakery.</li>
				<li><strong>All-in-One Stop:</strong> Grab groceries and a hot lunch in one visit.</li>
				<li><strong>Local & Family-Owned:</strong> Proudly serving Auburn with friendly service.</li>
			</ul>

			<h3>Visit Our Counter Today</h3>
			<p>
				Stop by El Mercado Latino today. Our friendly team is ready to help you select the perfect, high-quality meats for your next meal. Experience true neighborhood butcher quality in Auburn.
			</p>
		</Article>
	</Section>
</Layout>
