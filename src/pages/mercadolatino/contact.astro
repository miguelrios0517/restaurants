---
import Layout from "~/layouts/mercadolatino/Layout.astro";
import Section from "~/components/Section.astro";
import Heading from "~/components/Heading.astro";
import FormContact from "~/components/forms/FormContact.astro";
import Button from "~/components/Button.astro";
import ButtonCallUs from "~/components/mercadolatino/ButtonCallUs.astro";

---

<Layout dataTheme="mercado-latino">
	<Section pageHero=true class:list={'brand-bg'}>
		<Heading>
			<h2 slot="heading-title" class="font-black h2">Hours & Location</h2>
			<p slot="heading-content">Get in touch with us for any questions or inquiries.</p>
		</Heading>
		<div class="grid sm:grid-cols-1 lg:grid-cols-3 gap-16">
			<div class="col-span-1">
				<div class = "hours">
					<h6>Hours</h6>
					<div class = "flex justify-between pb-6">
						<div><p>Monday - Friday</p></div>
						<div><p><b>8am-9pm</b></p></div>
					</div>
					<div class = "flex justify-between pb-6">
						<div><p>Weekend</p></div>
						<div><p><b>8am-9pm</b></p></div>
					</div>
				</div>
				<div class = "hours">
					<h6>Location</h6>
					<p>1807 Howard Rd<br> Auburn, WA 98002, USA</p>
				</div>
				<div class = "hours">
					<h6>Order Ahead</h6>
					<div class="mt-4">
						<!-- <Button color = "red" url="/menu">
							(253) 333-7777
						</Button> -->
						<ButtonCallUs></ButtonCallUs>
					</div>
				
				</div>
			</div>
			<div class="col-span-2">
				<iframe width="100%" height="600px" frameborder="0" title="map" marginheight="0" marginwidth="0" scrolling="no" src="https://maps.google.com/maps?width=100%&amp;height=600&amp;hl=en&amp;q=gingerteriyakiauburn+(Ginger%20Teriyaki%20Auburn%20WA)&amp;ie=UTF8&amp;t=&amp;z=14&amp;iwloc=B&amp;output=embed"></iframe>	
			</div>
		</div>
	</Section>
</Layout>
