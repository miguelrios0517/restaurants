import Section from "~/components/Section.astro";
import Heading from "~/components/Heading.astro";
import MenuList from "~/components/mercadolatino/Menu.astro";
---

<Layout dataTheme="mercado-latino">
	<Section pageHero=true>
		<Heading>
			<h1 slot="heading-title" class="font-black h2">Our Menu</h1>
