---
import Layout from "~/layouts/gingerteriyaki/Layout.astro";
import Section from "~/components/Section.astro";
import Hero from "~/components/Hero.astro";
import { Picture, Image } from "astro:assets";
import Badge from "~/components/Badge.astro";
import Button from "~/components/Button.astro";

import ButtonCallUs from "~/components/gingerteriyaki/ButtonCallUs.astro";
import Grid from "~/components/Grid.astro";
import Heading from "~/components/Heading.astro";
import WideImage from "~/components/WideImage.astro";
import ReviewSlider from "~/components/gingerteriyaki/ReviewSlider.astro";

// Images
import Teriyaki from "~/assets/images/gingerteriyaki/teriyaki.jpeg";
import TeriyakiWide from "~/assets/images/gingerteriyaki/teriyaki_wide.jpeg";
import Teriyaki2 from "~/assets/images/gingerteriyaki/teriyaki2.jpeg";
import Teriyaki3 from "~/assets/images/gingerteriyaki/teriyaki3.jpeg";
import FriedRice from "~/assets/images/gingerteriyaki/friedrice.jpeg";
import Gyoza from "~/assets/images/gingerteriyaki/gyoza.jpeg";
import Katsu from "~/assets/images/gingerteriyaki/katsu.jpeg";
import GingerTeriyaki from "~/assets/images/gingerteriyaki/gingerteriyaki_cropped.jpg";


import PizzaHero from "~/assets/images/gingerteriyaki/pexels-shvetsa-5953523.jpg";
import Pizza from "~/assets/images/gingerteriyaki/pizza.png";
import Spaghetti from "~/assets/images/gingerteriyaki/spaghetti.png";
import Fish from "~/assets/images/gingerteriyaki/fish.png";
import DecorativeImage from "~/assets/images/gingerteriyaki/pexels-shvetsa-5953523.jpg";
import reviewAuthors from "~/assets/images/gingerteriyaki/review-icons.png";
import Dessert from "~/assets/images/gingerteriyaki/dessert.png";
import Mussels from "~/assets/images/gingerteriyaki/mussels2.png";
---

<Layout title="Home" pageTitle="Home" description="Welcome to our restaurant!" dataTheme="ginger-teriyaki">
	<Section hero={true} class:list={"brand-bg"}>
		<Hero>
			<div slot="hero-content-left" class="prose max-w-none max-lg:order-1">
				<Badge color="primary" title="Authentic Japanese Cuisine" />
				<h1 class="font-black">Ginger Teriyaki in Auburn, Washington</h1>

				<p>
					Craving real, flame-broiled goodness? At Ginger Teriyaki, we serve up massive portions of tender chicken, beef, and wok-tossed veggies, all drenched in our signature homemade ginger-infused sauce. Fresh, fast, and fiercely flavorful—your perfect meal awaits.
				</p>

				<span class="text-brand-black font-medium">✔ Dine-in or Takeout</span>

				<div class="mt-8 flex items-center gap-x-8">
					<Button color="secondary" url="/book">Get Directions</Button>
					<ButtonCallUs />
				</div>
			</div>
			<div slot="hero-content-right">
				<Picture
					class:list={"mx-auto service-image-blob"}
					src={Teriyaki}
					height={600}
					formats={["avif", "webp"]}
					alt="A description of my image."
					loading={"eager"}
					fetchpriority={"high"}
				/>
			</div>
		</Hero>
	</Section>

	<WideImage image={GingerTeriyaki} alt="Just an image" class:list={"aspect-video lg:aspect-[16/6]"} />

	<!-- Dishes -->
	<Section class:list={"brand-bg"}>
		<Heading>
			<h2 slot="heading-title" class="font-black h2">Our Menu</h2>
			<p slot="heading-content">
				Fresh ingredients, bold PNW flavors, and portions that never leave you hungry.
			</p>
		</Heading>

		<Grid>
			<div slot="grid-content-1">
				<div class="flex flex-col items-center prose text-center">
					<Picture
						class:list={"not-prose w-full h-auto service-image-blob"}
						src={Teriyaki2}
						formats={["avif", "webp"]}
						alt="A description of my image."
					/>
					<h3 class="h4 mt-0 font-black">Teriyaki</h3>
					<p>
						Grilled to perfection. Served with our signature house-made ginger teriyaki sauce, a double scoop of fluffy white rice, and a crisp, refreshing side salad.
					</p>
				</div>
			</div>

			<div slot="grid-content-2">
				<div class="flex flex-col items-center prose text-center">
					<Picture
						class:list={"not-prose w-full h-auto service-image-blob"}
						src={Gyoza}
						formats={["avif", "webp"]}
						alt="A description of my image."
					/>
					<h3 class="h4 mt-0 font-black">Appetizers</h3>
					<p>
						The perfect start to your meal. Enjoy crisp, golden egg rolls, pan-fried pork gyoza, or crunchy prawn tempura—all served hot with delicious dipping sauces.
					</p>
				</div>
			</div>

			<div slot="grid-content-3">
				<div class="flex flex-col items-center prose text-center">
					<Picture
						class:list={"not-prose w-full h-auto service-image-blob"}
						src={FriedRice}
						formats={["avif", "webp"]}
						alt="A description of my image."
					/>
					<h3 class="h4 mt-0 font-black">Entrees</h3>
					<p>
						The perfect start to your meal. Enjoy crisp, golden egg rolls, pan-fried pork gyoza, or crunchy prawn tempura—all served hot with delicious dipping sauces.
					</p>
				</div>
			</div>
		</Grid>
	</Section>

	<!-- Reviews -->
	<Section class:list={"bg-brand-secondary/30 relative"}>
		<div class="py-16">
			<Hero>
				<div slot="hero-content-left" class="prose max-w-none order-2">
					<div class="text-center not-prose">
						<Badge color="white" title="Local Reviews" />
					</div>
					<h2 slot="heading-title" class="font-black h4 text-center mt-0 mb-4">What Our Customers Say...</h2>
					<div slot="heading-content">
						<p class="text-center">
							Don't just take our word for it. Read what our customers have to say about their dining
							experience at our restaurant.
						</p>

						<ReviewSlider />
					</div>
				</div>

				<div slot="hero-content-right">
					<Picture height={400} src={reviewAuthors} alt="Review authors">
				</div>
			</Hero>
		</div>

		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 1440 320"
			class="absolute h-40 w-full top-0 inset-x-0 rotate-180 fill-brand-bg"
			preserveAspectRatio="none"
			><path
				fill-opacity="1"
				d="M0,288L48,272C96,256,192,224,288,197.3C384,171,480,149,576,165.3C672,181,768,235,864,250.7C960,267,1056,245,1152,250.7C1248,256,1344,288,1392,304L1440,320L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
			></path>
		</svg>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 1440 320"
			class="absolute h-40 w-full bottom-0 inset-x-0 fill-brand-bg"
			preserveAspectRatio="none"
			><path
				fill-opacity="1"
				d="M0,288L48,272C96,256,192,224,288,197.3C384,171,480,149,576,165.3C672,181,768,235,864,250.7C960,267,1056,245,1152,250.7C1248,256,1344,288,1392,304L1440,320L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
			></path>
		</svg>
	</Section>

	<!-- About -->
	<Section class:list={"brand-bg"}>
		<Hero>
			<div slot="hero-content-left" class="prose lg:order-2">
				<h2 class="font-black">Top Teriyaki Since '02</h2>

				<p>
					For years, Ginger Teriyaki has been proudly fueling the Auburn community with honest, delicious, and deeply satisfying comfort food. We believe that great teriyaki is an art form. That’s why we never cut corners: our meats are high-quality and meticulously marinated, our vegetables are chopped fresh daily, and our legendary ginger teriyaki sauce is simmered to perfection right here in our kitchen. 
				</p>

				<p>
				Whether you are grabbing a quick lunch break, feeding the whole family, or picking up takeout on your way home, we welcome you with fast service and a warm smile. Taste the local difference today.
				</p>

				<div class="mt-8">
					<Button color = "secondary" url="/menu">
						
						Get Directions
					</Button>
				</div>
			</div>
			<div slot="hero-content-right">
				<Picture
					class:list={"mx-auto image-blob"}
					src={Teriyaki3}
					height={600}
					formats={["avif", "webp"]}
					alt="A description of my image."
				/>
			</div>
		</Hero>
	</Section>

	<!-- Map -->
	<iframe width="100%" height="600px" frameborder="0" title="map" marginheight="0" marginwidth="0" scrolling="no" src="https://maps.google.com/maps?width=100%&amp;height=600&amp;hl=en&amp;q=gingerteriyakiauburn+(Ginger%20Teriyaki%20Auburn%20WA)&amp;ie=UTF8&amp;t=&amp;z=14&amp;iwloc=B&amp;output=embed"></iframe>	
</Layout>
